<idea-plugin>
    <id>com.example.jsonviewer</id>
    <name>JSON Tree</name>
    <vendor email="dev@example.com">Pavel Rotari</vendor>

    <description><![CDATA[Displays the currently open JSON file as a tree with icons, collapse/expand, refresh, and search.]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="JSON Tree"
                    factoryClass="com.example.jsonviewer.JsonTreeToolWindowFactory"
                    anchor="right"
                    icon="/icons/icon.svg"
                    secondary="true"
                    doNotActivateOnStart="true"
        />
    </extensions>
</idea-plugin>
